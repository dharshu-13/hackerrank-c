#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int a, b;
    // Read the two integers defining the interval
    if (scanf("%d\n%d", &a, &b) != 2) {
        return 1;
    }

    // Array of string representations for indices 1 to 9
    char* words[] = {"one", "two", "three", "four", "five", "six", "seven", "eight", "nine"};

    // Iterate through the interval [a, b] inclusive
    for (int i = a; i <= b; i++) {
        if (i >= 1 && i <= 9) {
            // i - 1 matches the 0-indexed array element
            printf("%s\n", words[i - 1]);
        } else if (i > 9) {
            if (i % 2 == 0) {
                printf("even\n");
            } else {
                printf("odd\n");
            }
        }
    }

    return 0;
}
